{
  "name": "quickdo",
  "version": "1.0.0",
  "description": "A lightweight, always-on Windows desktop task capture app",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "keywords": ["productivity", "tasks", "desktop", "electron"],
  "author": "quickDo",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "chrono-node": "^2.7.6"
  },
  "build": {
    "appId": "com.quickdo.app",
    "productName": "quickDo",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ]
  }
}
