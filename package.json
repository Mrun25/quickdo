{
  "name": "quickdo",
  "version": "1.0.0",
  "description": "Floating Task Widget — lightweight, always-on-top Windows desktop app",
  "main": "installer/main.js",
  "author": "QuickDo Contributors",
  "license": "MIT",
  "homepage": "https://github.com/your-username/quickdo",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/quickdo.git"
  },
  "scripts": {
    "start":     "electron .",
    "dev":       "electron . --inspect",
    "build":     "electron-builder --win --x64",
    "build:all": "electron-builder --win --mac --linux",
    "pack":      "electron-builder --dir",
    "lint":      "eslint src/**/*.js installer/*.js"
  },
  "devDependencies": {
    "electron":         "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint":           "^8.0.0"
  },
  "build": {
    "appId":       "com.quickdo.app",
    "productName": "QuickDo",
    "copyright":   "Copyright © 2026 QuickDo Contributors",
    "files": [
      "index.html",
      "src/**/*",
      "assets/**/*",
      "installer/main.js",
      "installer/preload.js"
    ],
    "extraResources": [
      { "from": "assets/", "to": "assets/" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon":            "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick":              true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName":          "QuickDo",
      "installerIcon":         "assets/icon.ico",
      "uninstallerIcon":       "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon":   "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "icon":   "assets/icon.png",
      "category": "Utility"
    }
  }
}
